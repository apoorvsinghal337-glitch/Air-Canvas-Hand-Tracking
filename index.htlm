
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Air Canvas | Hand Tracking</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #090e1b;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
    }
    h1 { color: #55e6ff; margin-bottom: 5px; }
    p { color: #aab7ce; font-size: 14px; }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 9px;
      padding: 15px;
    }
    button {
      border: 1px solid #334155;
      background: #17243c;
      color: white;
      padding: 12px;
      border-radius: 10px;
      cursor: pointer;
    }
    button.active { border-color: #55e6ff; }
    button:disabled { opacity: .5; }
    .stage {
      position: relative;
      width: min(95vw, 900px);
      aspect-ratio: 4 / 3;
      margin: auto;
      overflow: hidden;
      border: 2px solid #334155;
      border-radius: 16px;
      background: #111827;
    }
    video, canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    video {
      object-fit: fill;
      transform: scaleX(-1);
    }
    canvas { pointer-events: none; }
    #paint { z-index: 1; }
    #overlay { z-index: 2; }
    #status { padding: 10px; color: #55e6ff; }
  </style>
</head>
<body>
  <h1>✋ AIR CANVAS AI</h1>
  <p>Draw in the air using your index finger</p>

  <div class="toolbar">
    <button id="start">📷 Start Camera</button>
    <button data-color="#00e5ff">🔵 Cyan</button>
    <button data-color="#ff477e">🔴 Pink</button>
    <button data-color="#facc15">🟡 Yellow</button>
    <button data-color="#ffffff">⚪ White</button>
    <button id="eraser">Eraser</button>
    <button id="clear">Clear</button>
    <button id="save">💾 Save PNG</button>
  </div>

  <div class="stage">
    <video id="video" autoplay muted playsinline></video>
    <canvas id="paint" width="800" height="600"></canvas>
    <canvas id="overlay" width="800" height="600"></canvas>
  </div>

  <div id="status">Press Start Camera</div>
  <p>☝️ Index finger up = Draw</p>
  <p>✌️ Index + middle fingers up = Pause</p>

  <script type="module">
    import {
      HandLandmarker,
      FilesetResolver
    } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/+esm";

    const video = document.getElementById("video");
    const paint = document.getElementById("paint");
    const overlay = document.getElementById("overlay");
    const ctx = paint.getContext("2d");
    const ox = overlay.getContext("2d");
    const status = document.getElementById("status");

    const W = paint.width;
    const H = paint.height;

    let landmarker;
    let stream;
    let running = false;
    let lastVideoTime = -1;
    let previous = null;
    let color = "#00e5ff";
    let erasing = false;

    ctx.lineWidth = 6;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";

    function fingerUp(points, tip, pip) {
      return points[tip].y < points[pip].y;
    }

    function drawFrame() {
      if (!running) return;

      if (
        video.readyState >= 2 &&
        video.currentTime !== lastVideoTime
      ) {
        lastVideoTime = video.currentTime;

        const result = landmarker.detectForVideo(
          video,
          performance.now()
        );

        ox.clearRect(0, 0, W, H);

        if (result.landmarks.length > 0) {
          const hand = result.landmarks[0];
          const indexUp = fingerUp(hand, 8, 6);
          const middleUp = fingerUp(hand, 12, 10);

          const x = (1 - hand[8].x) * W;
          const y = hand[8].y * H;

          ox.beginPath();
          ox.arc(x, y, 10, 0, Math.PI * 2);
          ox.fillStyle = "#00ff99";
          ox.fill();

          if (indexUp && !middleUp) {
            status.textContent = erasing
              ? "Erasing..."
              : "Drawing...";

            if (previous) {
              ctx.save();
              ctx.globalCompositeOperation = erasing
                ? "destination-out"
                : "source-over";
              ctx.strokeStyle = color;
              ctx.lineWidth = erasing ? 35 : 6;

              ctx.beginPath();
              ctx.moveTo(previous.x, previous.y);
              ctx.lineTo(x, y);
              ctx.stroke();
              ctx.restore();
            }

            previous = { x, y };
          } else {
            previous = null;
            status.textContent = "Hand detected - paused";
          }
        } else {
          previous = null;
          status.textContent = "Show your hand to camera";
        }
      }

      requestAnimationFrame(drawFrame);
    }

    document.getElementById("start").onclick = async () => {
      const button = document.getElementById("start");
      button.disabled = true;
      status.textContent = "Loading AI model...";

      try {
        const vision = await FilesetResolver.forVisionTasks(
          "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/wasm"
        );

        landmarker = await HandLandmarker.createFromOptions(
          vision,
          {
            baseOptions: {
              modelAssetPath:
                "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",
              delegate: "CPU"
            },
            runningMode: "VIDEO",
            numHands: 1
          }
        );

        stream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: {
            facingMode: "user",
            width: 800,
            height: 600
          }
        });

        video.srcObject = stream;
        await video.play();

        running = true;
        button.textContent = "Camera Running";
        status.textContent = "Show your hand!";
        drawFrame();
      } catch (error) {
        status.textContent = "Error: " + error.message;
        button.disabled = false;
      }
    };

    document.querySelectorAll("[data-color]").forEach(btn => {
      btn.onclick = () => {
        color = btn.dataset.color;
        erasing = false;
        previous = null;
      };
    });

    document.getElementById("eraser").onclick = () => {
      erasing = true;
      previous = null;
      status.textContent = "Eraser selected";
    };

    document.getElementById("clear").onclick = () => {
      ctx.clearRect(0, 0, W, H);
      previous = null;
    };

    document.getElementById("save").onclick = () => {
      const output = document.createElement("canvas");
      output.width = W;
      output.height = H;

      const out = output.getContext("2d");
      out.fillStyle = "#ffffff";
      out.fillRect(0, 0, W, H);
      out.drawImage(paint, 0, 0);

      const link = document.createElement("a");
      link.download = "AirCanvas-Drawing.png";
      link.href = output.toDataURL("image/png");
      link.click();
    };
  </script>
</body>
</html>

